# Loaded automatically by Vite/Vitest for the "test" mode (Vitest's default
# mode). supabaseClient.ts throws at import time if these are missing, and
# tests never make a real network call - the supabase client is mocked in
# every test that touches it - so these values just need to be well-formed,
# not real.
VITE_SUPABASE_URL=https://test.supabase.local
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_key
